%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#232F3E', 'primaryTextColor': '#fff', 'primaryBorderColor': '#FF9900', 'lineColor': '#FF9900', 'secondaryColor': '#006600', 'tertiaryColor': '#fff'}}}%%
flowchart TB
    subgraph AWS["AWS Cloud"]
        subgraph VPC["VPC (10.0.0.0/16)"]
            IGW["Internet Gateway"]
            
            subgraph PublicSubnet["Public Subnet B<br/>10.0.3.0/24"]
                NAT["NAT Gateway"]
                InstanceB["EC2 Instance B<br/>(Unprotected)<br/>Traffic Generator"]
            end
            
            subgraph FirewallSubnet["Firewall Subnet A<br/>10.0.2.0/24"]
                NFW["AWS Network Firewall<br/>Endpoint"]
            end
            
            subgraph ProtectedSubnet["Protected Subnet A<br/>10.0.1.0/24"]
                InstanceA["EC2 Instance A<br/>(Protected)<br/>Mock HTTP Server"]
            end
            
            subgraph FirewallPolicy["Network Firewall Policy"]
                Emprovise["AWS<br/>ThreatSignaturesBotnetActionOrder<br/>Rule Group"]
            end
        end
        
        subgraph CloudWatch["CloudWatch Logs"]
            FlowLogs["Flow Logs"]
            AlertLogs["Alert Logs"]
        end
    end
    
    Internet((Internet))
    
    %% Internet Ingress Flow
    Internet -->|"Ingress"| IGW
    IGW -->|"Route to<br/>Protected Subnet"| NFW
    NFW -->|"Inspected<br/>Traffic"| InstanceA
    
    %% Egress Flow from Protected Subnet
    InstanceA -->|"Egress to<br/>Internet"| NFW
    NFW -->|"Inspected<br/>Traffic"| NAT
    NAT --> IGW
    IGW -->|"Egress"| Internet
    
    %% Cross-Subnet Traffic (Instance B to Instance A)
    InstanceB -->|"Traffic to<br/>Protected Subnet"| NFW
    NFW -->|"Inspected<br/>Traffic"| InstanceA
    
    %% Instance A to Instance B (through firewall)
    InstanceA -.->|"Traffic to<br/>Public Subnet"| NFW
    NFW -.->|"Inspected"| InstanceB
    
    %% Instance B Direct Internet Access (Unprotected)
    InstanceB <-->|"Direct Internet<br/>(Unprotected)"| IGW
    
    %% Firewall Policy Connection
    NFW --- FirewallPolicy
    
    %% Logging
    NFW -->|"Logs"| FlowLogs
    NFW -->|"Alerts"| AlertLogs
    
    %% Styling
    classDef awsService fill:#FF9900,stroke:#232F3E,stroke-width:2px,color:#232F3E
    classDef subnet fill:#E8F5E9,stroke:#4CAF50,stroke-width:2px,color:#232F3E
    classDef instance fill:#42A5F5,stroke:#1976D2,stroke-width:2px,color:#fff
    classDef firewall fill:#E53935,stroke:#B71C1C,stroke-width:2px,color:#fff
    classDef policy fill:#7B1FA2,stroke:#4A148C,stroke-width:2px,color:#fff
    classDef logs fill:#78909C,stroke:#455A64,stroke-width:2px,color:#fff
    classDef internet fill:#616161,stroke:#212121,stroke-width:2px,color:#fff
    
    class IGW,NAT awsService
    class PublicSubnet,FirewallSubnet,ProtectedSubnet subnet
    class InstanceA,InstanceB instance
    class NFW firewall
    class FirewallPolicy,Emprovise policy
    class FlowLogs,AlertLogs logs
    class Internet internet
